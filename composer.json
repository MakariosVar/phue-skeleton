{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "makariosvar/phue-skeleton",
    "description": "Phue Application",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.5",
        "makariosvar/phue": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/MakariosVar/phue",
            "no-api": true
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "platform-check": false,
        "sort-packages": true
    }
}
